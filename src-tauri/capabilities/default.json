{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: Runtime relay, logs, opening links, ALwith platform requests and the named store",
  "windows": [
    "main",
    "vibemon",
    "bubble-menu-vibemon",
    "settings",
    "guide"
  ],
  "permissions": [
    "core:default",
    "alwith-desktop-shell:default",
    "log:default",
    "opener:default",
    "os:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.alwith.ai/service/**"
        },
        {
          "url": "https://api-dev.alwith.ai/service/**"
        }
      ]
    },
    "alwith-store:default",
    "alwith-auth:default",
    "alwith-auth:vibemon",
    "core:app:allow-set-app-theme",
    "core:webview:allow-create-webview-window",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "opener:allow-open-path",
    "opener:allow-reveal-items-in-dir"
  ]
}
