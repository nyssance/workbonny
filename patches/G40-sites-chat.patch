+import type * as acp from "@agentclientprotocol/sdk/experimental/v2/unstable"
+
+/** Explicit application links survive draft persistence and become native Codex mentions. */
+export function appMentionLink(app: { id: string; runtimeName: string | null }): string {
+  const name = (app.runtimeName || app.id).replace(/[\[\]\\\r\n]/g, " ").trim()
+  return `[$${name}](app://${app.id})`
+}
+
+export function appMentionBlocks(text: string): acp.ContentBlock[] {
+  const seen = new Set<string>()
+  return [...text.matchAll(/\[\$([^\]\r\n]+)\]\((app:\/\/[^/?#\s)]+)\)/g)].flatMap((match) => {
+    const [, name, uri] = match
+    if (!name || !uri || seen.has(uri)) return []
+    seen.add(uri)
+    return [{ type: "resource_link" as const, name, uri }]
+  })
+}
