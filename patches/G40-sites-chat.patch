+import { BlocksIcon } from "lucide-react"
+import { useRef, useState } from "react"
+import { DropdownMenu, DropdownMenuContent, DropdownMenuGroup, DropdownMenuItem, DropdownMenuTrigger } from "@/components/ui/dropdown-menu"
+import { PromptInputButton } from "../../composer/prompt-input"
+import { useConversation } from "../context"
+import { appMentionLink } from "./app-mentions"
+
+type App = { id: string; runtimeName: string | null; enabled: boolean; callable: boolean }
+
+export function AppsMenu({ disabled, onSelect }: { disabled: boolean; onSelect: (link: string) => void }) {
+  const { client, host } = useConversation()
+  const [open, setOpen] = useState(false)
+  const [apps, setApps] = useState<App[]>([])
+  const [status, setStatus] = useState<"loading" | "ready" | "error">("loading")
+  const generation = useRef(0)
+  // Older adapters remain usable; no unavailable application entry is shown.
+  const listApps = client.installedApps?.bind(client)
+  if (!listApps) return null
+  const changeOpen = (next: boolean) => {
+    setOpen(next)
+    const current = ++generation.current
+    if (!next) return
+    setStatus("loading")
+    void listApps().then(({ apps }) => {
+      if (current !== generation.current) return
+      setApps(apps.filter((app) => app.enabled && app.callable))
+      setStatus("ready")
+    }, (error: unknown) => {
+      if (current !== generation.current) return
+      setStatus("error")
+      host.reportError?.(error)
+    })
+  }
+  return (
+    <DropdownMenu open={open} onOpenChange={changeOpen}>
+      <DropdownMenuTrigger render={<PromptInputButton disabled={disabled} aria-label={host.t("composer.apps")} title={host.t("composer.apps")}><BlocksIcon /></PromptInputButton>} />
+      <DropdownMenuContent align="start" side="top" className="max-h-72 min-w-48 overflow-y-auto">
+        <DropdownMenuGroup>
+          {status !== "ready" ? <DropdownMenuItem disabled>{host.t(status === "loading" ? "composer.appsLoading" : "composer.appsFailed")}</DropdownMenuItem>
+            : apps.length === 0 ? <DropdownMenuItem disabled>{host.t("composer.appsEmpty")}</DropdownMenuItem>
+            : apps.map((app) => <DropdownMenuItem key={app.id} onClick={() => { onSelect(appMentionLink(app)); changeOpen(false) }}>{app.runtimeName || app.id}</DropdownMenuItem>)}
+        </DropdownMenuGroup>
+      </DropdownMenuContent>
+    </DropdownMenu>
+  )
+}
