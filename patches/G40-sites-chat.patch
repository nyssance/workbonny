+import { afterEach, expect, mock, test } from "bun:test"
+import { act, cleanup, fireEvent, render, screen } from "@testing-library/react"
+import { installDom } from "../../codex/__tests__/dom-environment"
+import { AppsMenu } from "../composer/apps-menu"
+import { conversationClient, conversationHost, inConversation, translator } from "./harness"
+
+installDom()
+afterEach(() => cleanup())
+const host = conversationHost({ t: translator("zh-CN") })
+
+test("only callable enabled apps can be selected; selection inserts a durable application link", async () => {
+  const selected = mock(() => {})
+  const installedApps = mock(async () => ({ apps: [
+    { id: "sites", runtimeName: "Sites", enabled: true, callable: true },
+    { id: "blocked", runtimeName: "Blocked", enabled: true, callable: false },
+    { id: "disabled", runtimeName: "Disabled", enabled: false, callable: true }
+  ] }))
+  const client = Object.assign(conversationClient(), { installedApps })
+  render(inConversation(<AppsMenu disabled={false} onSelect={selected} />, host, client))
+  await act(async () => { fireEvent.click(screen.getByRole("button", { name: "应用" })); await new Promise(requestAnimationFrame) })
+  expect(screen.queryByText("Blocked")).toBeNull()
+  expect(screen.queryByText("Disabled")).toBeNull()
+  fireEvent.click(screen.getByRole("menuitem", { name: "Sites" }))
+  expect(selected).toHaveBeenCalledWith("[$Sites](app://sites)")
+  expect(installedApps).toHaveBeenCalledTimes(1)
+})
+
+test("failed query reports an error and does not retry", async () => {
+  const error = new Error("offline")
+  const installedApps = mock(async () => { throw error })
+  const reportError = mock(() => {})
+  render(inConversation(<AppsMenu disabled={false} onSelect={() => {}} />, { ...host, reportError }, Object.assign(conversationClient(), { installedApps })))
+  await act(async () => { fireEvent.click(screen.getByRole("button", { name: "应用" })); await new Promise(requestAnimationFrame) })
+  expect(screen.getByText("应用读取失败")).toBeTruthy()
+  expect(reportError).toHaveBeenCalledWith(error)
+  expect(installedApps).toHaveBeenCalledTimes(1)
+})
