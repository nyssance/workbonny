+import { describe, expect, test } from "bun:test"
+import { appMentionBlocks, appMentionLink } from "./app-mentions"
+
+describe("explicit application mentions", () => {
+  test("preserves a selected app through a saved text draft and deduplicates it", () => {
+    const link = appMentionLink({ id: "connector_sites", runtimeName: "Sites" })
+    expect(appMentionBlocks(`${link} read my sites ${link}`)).toEqual([{type: "resource_link", name: "Sites", uri: "app://connector_sites"}])
+  })
+  test("does not activate apps from plain names, web links or malformed ids", () => {
+    expect(appMentionBlocks("Sites $sites [Sites](https://example.com) [$Sites](app://sites/path)")).toEqual([])
+  })
+})
