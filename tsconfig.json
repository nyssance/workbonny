{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "bun"
    ],
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*",
        "./node_modules/@nyssance/reui/dist/vega/*",
        "./node_modules/@nyssance/shadcn/dist/vega/*"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "vite.config.ts",
    "tests/**/*.test.ts"
  ]
}
