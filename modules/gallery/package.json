{
  "name": "@workbonny/module-gallery",
  "version": "0.5.0",
  "type": "module",
  "license": "MIT",
  "description": "Open-source local image gallery with an automatic five-slice exhibition view",
  "files": [
    "dist",
    "src",
    "rust/src",
    "rust/permissions",
    "rust/Cargo.toml",
    "rust/build.rs",
    "rust/LICENSE",
    "LICENSE",
    "README.md",
    "build.ts",
    "tsconfig.json"
  ],
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./dist/index.js"
    },
    "./tauri": {
      "types": "./src/tauri.ts",
      "import": "./dist/tauri.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.3.0",
    "@tauri-apps/api": "^3.0.0-alpha.3",
    "@nyssance/shadcn": "^4.23",
    "lucide-react": "^1.67"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test src",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
